# Copie para .env.local e ajuste. Variáveis VITE_* são embutidas no build (no Vercel, configure
# o mesmo nome nas variáveis de ambiente do projeto).

# notification-service (conexão do Telegram). Padrão: http://localhost:8341
VITE_NOTIFICATION_API_URL=http://localhost:8341

# ocr-service. Deixe vazio para o modo demonstração (o reconhecimento é simulado).
# Rota usada: POST {URL}/v1/extraction (services/ocr-service/docs/contrato-api.md)
VITE_OCR_API_URL=

# database-service (estante e livros). Deixe vazio para a estante de exemplo.
# No desenvolvimento use /api/v1: o Vite repassa para http://localhost:8321 (o serviço ainda não libera CORS).
# Contrato: docs/api/database-service.md
VITE_DATABASE_API_URL=

# Id numérico do usuário no banco (crie com POST /api/v1/usuario). Vazio = usuário de exemplo (teste-1).
# É também o id usado no cartão do Telegram.
VITE_USUARIO_ID=
