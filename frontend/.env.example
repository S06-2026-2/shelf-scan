# Copie para .env.local e ajuste. Variáveis VITE_* são embutidas no build (no Vercel, configure
# o mesmo nome nas variáveis de ambiente do projeto).

# notification-service (conexão do Telegram). Padrão: http://localhost:8341
VITE_NOTIFICATION_API_URL=http://localhost:8341

# ocr-service. Deixe vazio para o modo demonstração (o reconhecimento é simulado).
VITE_OCR_API_URL=
