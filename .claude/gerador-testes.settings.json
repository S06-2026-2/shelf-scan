{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(./services/database-service/src/test-agente/**)",
      "Edit(./services/database-service/target/relatorio-agente.md)",
      "Bash(cd services/database-service)",
      "Bash(sh mvnw *)"
    ],
    "deny": [
      "Edit(./services/database-service/src/main/**)",
      "Edit(./services/database-service/src/test/**)",
      "Edit(./services/database-service/pom.xml)",
      "Edit(./docs/**)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Bash(git *)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
